FLASK_APP=run.py
FLASK_DEBUG=0

# ── Secrets (override in production) ─────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too-please

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (dev). A relative sqlite path is anchored to the backend/ directory
# (not the process CWD), so it resolves the same from any working directory.
DATABASE_URL=sqlite:///instance/ccu.db
# PostgreSQL (Railway): the Postgres plugin exposes DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
ARCHIVE_FOLDER=archive
MAX_CONTENT_LENGTH=33554432

# ── Bootstrap user accounts ──────────────────────────────────────────────────
# REQUIRED in production: set strong, unique passwords. If left unset while
# FLASK_DEBUG is off, the seed step refuses to create these accounts. Only in
# debug/dev (FLASK_DEBUG=1) does the bootstrap fall back to throwaway defaults.
ADMIN_EMAIL=admin@ccu.kz
ADMIN_PASSWORD=
VIEWER_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_TTL_HOURS=12

# ── Networking ───────────────────────────────────────────────────────────────
# Railway provides $PORT automatically.
PORT=5000
# Comma-separated allow-list. Use "*" for any origin (dev only).
CORS_ORIGINS=*

# ── ЭЦП verification (NCANode — legal-grade GOST + chain + revocation) ────────
# Point this at a running NCANode service (official KalkanCrypt SDK) to verify
# GOST signatures, the certificate chain to the НУЦ РК root and revocation
# (OCSP/CRL) — required when the documents legally replace paper contracts.
# Unset = in-process verification only (RSA/ECDSA fully; GOST accepted with a
# document binding but NOT cryptographically/chain/revocation verified).
# NCANODE_URL=http://ncanode:14579
# Reject (instead of falling back to the in-process check) when NCANode is
# configured but unreachable. Turn ON (=1) for production-legal operation.
NCANODE_STRICT=0
NCANODE_VERIFY_OCSP=1
NCANODE_VERIFY_CRL=0

# ── Frontend wiring ──────────────────────────────────────────────────────────
# Path (absolute or relative to backend/) to Vite's `dist/` directory.
# Defaults to ../frontend/dist; in the Railway Docker image this is
# /app/frontend/dist.
# FRONTEND_DIST=/app/frontend/dist
