# When the frontend is served by the Flask backend (same origin), leave this
# empty so requests go to relative "/api". Set it to e.g.
# "https://ccu-api.example.com" when hosting the SPA on a separate origin.
VITE_API_BASE_URL=

# Dev-only: where `vite` proxies /api during `npm run dev`.
VITE_DEV_API_PROXY=http://127.0.0.1:5000
VITE_DEV_PORT=5173
VITE_DEV_HOST=127.0.0.1
