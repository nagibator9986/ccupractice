# Python
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/instance/*
!backend/instance/.gitkeep
backend/archive/
backend/uploads/
backend/.env

# All enrollment templates are rebuilt (and stale versions swept) on every
# ensure_enrollment_templates() call — see backend/app/services/
# enrollment_template_builder.py. Committing them is a foot-gun: the built
# files get silently unlinked at runtime on the first startup and can shadow
# the current builder on any deploy that races the sweep. The SOURCE .docx
# files under templates_docx/source/ stay tracked — they're the input, not
# the derivative.
backend/templates_docx/consent_template_v*.docx
backend/templates_docx/contract_enrollment_template_v*.docx
backend/templates_docx/contract_lms_template_v*.docx

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.local

# OS
.DS_Store

# Local Docker artifacts
*.pid
